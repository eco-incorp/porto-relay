# Porto Relay Environment Variables
# Copy this file to .env and fill in your actual values

# ============================================================================
# Relay Service Configuration
# ============================================================================

# CoinGecko API Key
# Get one at: https://www.coingecko.com/en/api/pricing
GECKO_API=YOUR_COINGECKO_API_KEY

# Relay Signer Mnemonic
# Used for generating relay transaction signers
RELAY_MNEMONIC=YOUR_RELAY_MNEMONIC

# Funder Signer Private Key
# Private key for the funder account
RELAY_FUNDER_SIGNER_KEY=YOUR_FUNDER_SIGNER_KEY

# Settler Signer Private Key
# Private key for the settler account
RELAY_SETTLER_SIGNER_KEY=YOUR_SETTLER_SIGNER_KEY

# Rust Logging Level
# Options: trace, debug, info, warn, error
RUST_LOG=info

# ============================================================================
# Lit Actions Server Configuration
# ============================================================================

# PKP Public Key
# Default is for datil-test network
PKP_PUBLIC_KEY=0477a05819c5ebbc5afd9fb799ff0ffb4fac069ad82bc267abe494f2524cd84e4c88f52f8829b7d037495be13164074158773af918288da14a22ed0d2d83ca1e1e

# PKP Wallet Owner Private Key
# Private key for PKP wallet owner authentication
PKP_WALLET_OWNER_PRIVATE_KEY=YOUR_PKP_WALLET_OWNER_PRIVATE_KEY

# ============================================================================
# Optional: PostgreSQL Configuration
# ============================================================================
# Uncomment if using the PostgreSQL service
# POSTGRES_DB=porto_relay
# POSTGRES_USER=relay
# POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD
