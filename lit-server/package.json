{
  "name": "@porto/lit-server",
  "version": "1.0.0",
  "description": "HTTP server for executing Lit Actions in Porto Relay",
  "main": "dist/server.js",
  "scripts": {
    "start": "ts-node src/server.ts",
    "dev": "ts-node-dev --respawn src/server.ts",
    "build": "tsc",
    "clean": "rm -rf dist node_modules"
  },
  "keywords": [
    "lit-protocol",
    "porto",
    "relay"
  ],
  "author": "Porto Team",
  "license": "MIT",
  "dependencies": {
    "@lit-protocol/auth-helpers": "^7.0.4",
    "@lit-protocol/constants": "^7.0.4",
    "@lit-protocol/lit-node-client": "^7.0.4",
    "dotenv": "^16.0.3",
    "ethers": "^5.7.2",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
